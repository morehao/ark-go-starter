{
  "name": "ark-go-starter-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ark-go-starter/demo-web dev",
    "dev:demo": "pnpm --filter @ark-go-starter/demo-web dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r --filter '@ark-go-starter/types' --filter '@ark-go-starter/api' --filter '@ark-go-starter/demo-web' exec tsc --noEmit -p tsconfig.json"
  },
  "packageManager": "pnpm@11.21.0"
}
