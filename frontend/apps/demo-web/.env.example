# demo-web 环境变量示例（复制为 .env.local 按需修改）

# IAM 接入模式：disabled（默认，不接入）| op（内嵌本进程 IAM，走同源 /iam）| rp（对接外部 ark-iam，直连 VITE_OIDC_ISSUER）
# 显式优先级最高；不设置时：有 VITE_OIDC_ISSUER 视为 rp，否则探测 /iam/config.json 可达则为 op，否则 disabled。
VITE_IAM_MODE=disabled

# ---- op 模式（内嵌 IAM）----
# 通常无需设置：issuer/clientID 由后端 /iam/config.json 下发；以下为可选兜底。
# VITE_OIDC_ISSUER=/oidc
# VITE_OIDC_CLIENT_ID=

# ---- rp 模式（对接外部 ark-iam）----
# 设置后自动进入 rp 模式（也可显式 VITE_IAM_MODE=rp）。issuer 为外部 OP 的绝对地址。
# VITE_OIDC_ISSUER=https://iam.example.com/oidc
# VITE_OIDC_CLIENT_ID=your-client-id

# ---- 兼容旧开关（等价于 VITE_IAM_MODE=op / disabled）----
# VITE_IAM_ENABLE=true
