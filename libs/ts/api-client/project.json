{
  "name": "ts-api-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ts/api-client",
  "tags": [
    "type:lib",
    "lang:ts"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "libs/ts/api-client"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "libs/ts/api-client"
      },
      "cache": true
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "openapi-typescript ../../../contracts/openapi/openapi.json -o src/schema.ts",
        "cwd": "libs/ts/api-client"
      },
      "cache": false
    }
  }
}
