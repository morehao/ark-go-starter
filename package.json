{
  "name": "ark-go-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ark-go-starter/demo-web dev",
    "dev:demo": "pnpm --filter @ark-go-starter/demo-web dev",
    "build": "pnpm -r --filter './libs/ts/*' --filter './apps/web' build",
    "typecheck": "pnpm -r --filter '!@ark-go-starter/tsconfig' exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint --config eslint.config.mjs apps/web libs/ts",
    "lint:fix": "eslint --config eslint.config.mjs apps/web libs/ts --fix"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nx/eslint-plugin": "^24.0.6",
    "@nx/js": "^24.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "nx": "^24.0.6",
    "typescript-eslint": "^8.72.2"
  }
}
