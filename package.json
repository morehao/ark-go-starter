{
  "name": "ark-go-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ark-go-starter/demo-web dev",
    "dev:demo": "pnpm --filter @ark-go-starter/demo-web dev",
    "build": "pnpm -r --filter './frontend/packages/*' --filter './frontend/apps/*' build",
    "typecheck": "pnpm -r --filter '!@ark-go-starter/tsconfig' exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint --config frontend/eslint.config.mjs frontend/apps frontend/packages",
    "lint:fix": "eslint --config frontend/eslint.config.mjs frontend/apps frontend/packages --fix"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
